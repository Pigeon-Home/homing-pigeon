<?xml version="1.0" encoding="UTF-8"?>
<!--
  Agent-Stamp: 00000000-muse-7e57-d0c5-58316a922026

  Info.plist template for the Mac App Store bundle, prepared
  2026-11-21 with runner/tools/apple_store.py. The bundle ID
  is the one the App Store Connect record was created with
  (Homing Pigeon Runner, created 2026-11-21); it must match
  the registered App ID and the provisioning profile exactly.

  __VERSION__ and __BUILD__ are tokens, not numbers: the
  build renders this template through the planner's
  render_info_plist, which fills them from the release's own
  version (the number pyproject.toml carries), mapped to
  the shapes the store accepts: the short version is the
  release version's first three components and the build is
  its last two, because Apple's validation refuses a bundle
  version of more than three integers. A literal version
  typed here would drift from the release; the test in
  runner/tests/test_apple_store.py holds the tokens in
  place.

  LSApplicationCategoryType names the listing's primary
  category (Developer Tools); Apple's validation refuses a
  bundle without it. CFBundleIconFile names AppIcon.icns
  beside this file, built from assets/logo.png with the
  full size set, the 512 point at 2x image included; the
  planner copies it into the bundle's Resources.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>homing-pigeon</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>ai.pigeon-home.homing-pigeon</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Homing Pigeon Runner</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
