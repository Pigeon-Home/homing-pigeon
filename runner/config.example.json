  "additional_secrets": {},
  "key_policies": {
    "ids-daemon": {"allowed_kinds": ["sensor_alert"]},
    "netmon-daemon": {"allowed_kinds": ["sensor_alert"]}
  },
  "max_result_view": "full",
  "max_query_budget": 8,
  "max_queries_per_hour": 0,
  "output_retention_days": 7,
  "workspace_root": "",
  "owner_instructions": "",
  "redact_patterns_extra": {},
  "review_patterns_extra": [],
  "inference": {
    "endpoint": "",
    "model": "",
