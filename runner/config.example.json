{
  "base_dir": "",
  "default_interpreter": [],
  "default_timeout_sec": 300,
  "imap_host": "imap.gmail.com",
  "imap_port": 993,
  "mailbox_password": "paste-app-password-here-in-plaintext",
  "mailbox_user": "homing-pigeon-runner@gmail.com",
  "max_job_age_sec": 3600,
  "max_output_bytes": 100000,
  "max_job_bytes": 4194304,
  "max_script_bytes": 1048576,
  "poll_interval_sec": 20,
  "smtp_host": "smtp.gmail.com",
  "smtp_port": 587,
  "workers": 1,
  "auth": "password",
  "oauth_client_id": "",
  "oauth_client_secret": "",
  "oauth_refresh_token": "",
  "shared_secret": "generate-with-openssl-rand-hex-32",
  "_shared_secret_file": "alternative: read the secret from a file instead of inline (mutually exclusive with shared_secret)",
  "additional_secrets": {},
  "_additional_secrets_files": "alternative: {\"key_id\": \"/path/to/file\"}, mutually exclusive per key with additional_secrets",
  "key_policies": {
    "ids-daemon": {"allowed_kinds": ["sensor_alert"]},
    "netmon-daemon": {"allowed_kinds": ["sensor_alert"]}
  },
  "key_policies_default_deny": false,
  "max_result_view": "full",
  "max_query_budget": 8,
  "max_queries_per_hour": 0,
  "output_retention_days": 7,
  "workspace_root": "",
  "owner_instructions": "",
  "redact_patterns_extra": {},
  "review_patterns_extra": [],
  "resources": {"enabled": true, "threshold": 0.95, "cooldown_sec": 900},
  "security": {
    "modes": {
      "policy_env": "off",
      "policy_files": "off",
      "policy_args": "off",
      "audience": "off",
      "confinement": "off",
      "job_user": "off"
    },
    "audit_max_lines": 20000
  },
  "dri": {
    "enabled": false,
    "channel": "telegram",
    "telegram_bot_token": "",
    "telegram_chat_id": "",
    "triggers": {
      "sensor_fused_score": {"threshold": 6.0, "window_sec": 600},
      "confinement_violation": true,
      "judge_block": true,
      "key_probe": {"threshold": 5, "window_sec": 3600},
      "resource_pressure": true
    },
    "cooldown_sec": 3600,
    "digest_window_sec": 300
  },
  "inference": {
    "endpoint": "",
    "model": "",
    "max_answer_chars": 2000,
    "timeout_sec": 60,
    "watch_system": true,
    "artifact_scan": true,
    "yara_rules": ""
  },
  "judge": "off",
  "dag_mode": "off",
  "task_timeout": 86400,
  "require_review": false,
  "worker_allowlist": [],
  "worker_compartments": {},
  "protected_paths": [],
  "sensors": {
    "host_ids": {
      "enabled": false,
      "key_id": "ids-daemon",
      "weight": 1.0,
      "profile": {
        "severity_floor": "low",
        "cooldown_sec": 300,
        "max_per_hour": 60
      }
    },
    "netmon": {
      "enabled": false,
      "key_id": "netmon-daemon",
      "weight": 0.7,
      "profile": {
        "severity_floor": "medium",
        "cooldown_sec": 600,
        "max_per_hour": 30
      }
    }
  }
}
