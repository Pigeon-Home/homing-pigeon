    "timeout_sec": 60
  },
  "judge": "off",
  "dag_mode": "off",
  "task_timeout": 86400,
  "require_review": false,
  "worker_allowlist": [],
  "worker_compartments": {},
  "protected_paths": [],
  "sensors": {
    "host_ids": {
      "enabled": false,
      "key_id": "ids-daemon",
      "weight": 1.0,
      "profile": {
        "severity_floor": "low",
        "cooldown_sec": 300,
        "max_per_hour": 60
      }
    },
    "netmon": {
      "enabled": false,
      "key_id": "netmon-daemon",
      "weight": 0.7,
      "profile": {
        "severity_floor": "medium",
        "cooldown_sec": 600,
        "max_per_hour": 30
      }
    }
  }
