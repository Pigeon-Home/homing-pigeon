! SELinux type-enforcement module for the Homing Pigeon runner (M7).
! Module name: homing_pigeon. NOT installed by default.
! Render @PLACEHOLDERS@ (see hardening/README.md), then:
!   checkmodule -M -m -o homing_pigeon.mod hardening/selinux/homing_pigeon.te
!   semodule_package -o homing_pigeon.pp -m homing_pigeon.mod
!   semodule -i homing_pigeon.pp
!
! This is a starting policy: it labels the runner and lets it do what a
! working run needs (TLS out to the mailbox, read its config, manage its
! base dir, run bwrap for sandboxed jobs). Extend it with audit2allow
! output from your own deployment before enforcing.

policy_module(homing_pigeon, 1.0.0)

! --- types ---
type homing_pigeon_t;
type homing_pigeon_exec_t;
type homing_pigeon_config_t;
type homing_pigeon_var_t;

! --- the runner runs as homing_pigeon_t ---
application_domain(homing_pigeon_t, homing_pigeon_exec_t)
role system_r types homing_pigeon_t;

! --- file contexts (apply with semanage fcontext) ---
! @RUNNER_DIR@(/.*)?    gen_context(system_u:object_r:homing_pigeon_exec_t,s0)
! @CONFIG@              gen_context(system_u:object_r:homing_pigeon_config_t,s0)
! @BASE_DIR@(/.*)?      gen_context(system_u:object_r:homing_pigeon_var_t,s0)

! --- what the runner may do ---
! Read its config.
allow homing_pigeon_t homing_pigeon_config_t:file read_file_perms;
! Manage its base dir (state, audit log, job workdirs).
manage_dirs_pattern(homing_pigeon_t, homing_pigeon_var_t, homing_pigeon_var_t)
manage_files_pattern(homing_pigeon_t, homing_pigeon_var_t, homing_pigeon_var_t)
! TLS out to the mailbox (IMAP/SMTP) and DNS.
corenet_tcp_connect_mta_port(homing_pigeon_t)
corenet_tcp_connect_http_port(homing_pigeon_t)
allow homing_pigeon_t cert_t:dir list_dir_perms;
allow homing_pigeon_t cert_t:file read_file_perms;
! Run the Python interpreter and bwrap for sandboxed jobs.
corecmd_exec_bin(homing_pigeon_t)
allow homing_pigeon_t bin_t:file map;
! Transitional: let bwrap do its mounts inside the job sandbox.
allow homing_pigeon_t self:capability { sys_admin sys_chroot setuid setgid };
allow homing_pigeon_t self:process { signal signull };
