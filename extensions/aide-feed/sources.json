{
  "sources_version": 1,
  "sources": [
    {
      "id": "aide",
      "role": "upstream",
      "upstream": true,
      "description": "AIDE, the file integrity checker whose reports this sense reads: its release source, and the code that writes the plain report.",
      "ref": "latest",
      "tag_match": "^v\\d+\\.\\d+(\\.\\d+)?$",
      "asset_match": "^aide-\\d+\\.\\d+(\\.\\d+)?\\.tar\\.gz$",
      "files": [
        "src/report.c",
        "src/report_plain.c",
        "COPYING"
      ],
      "archive": true,
      "max_mb": 16
    }
  ]
}
