{
  "sources_version": 1,
  "sources": [
    {
      "id": "aide",
      "role": "upstream",
      "description": "AIDE, the file integrity checker whose reports this sense reads: its release source.",
      "license": "GPL-2.0-or-later",
      "github": "aide/aide",
      "ref": "latest",
      "tag_match": "^v\\d+\\.\\d+(\\.\\d+)?$",
      "asset_match": "^aide-\\d+\\.\\d+(\\.\\d+)?\\.tar\\.gz$",
      "files": [
        "COPYING"
      ],
      "archive": true,
      "max_mb": 16
    }
  ]
}
