BEGIN build_pilot.py
#!/usr/bin/env python3
"""Build an offline shadow archive from one pinned Homing Pigeon ledger."""

from collections import Counter, defaultdict
import argparse
import gzip
import hashlib
import json
from pathlib import Path
import re


SOURCE_COMMIT = "e4af97f1be509d7cc2ec7761bd19a8ed0c4aed1e"
SOURCE_PATH = "runner/tests/de_dust/runs.jsonl"
SOURCE_BLOB = "ba50b24c91672464f11341c76ff6003c03a7526e"
DAY = "2026-11-19"
SCOPE = ("target", "rig", "head", "platform", "python", "technique")
OUTCOMES = ("accepted", "refused", "crash", "slow")
TOKEN = re.compile(r"[A-Za-z]+|[0-9]+|[^\sA-Za-z0-9]")


def digest(data):
    return hashlib.sha256(data).hexdigest()


def tokens(data):
    return len(TOKEN.findall(data.decode("utf-8")))


def line(value):
    return (json.dumps(value, separators=(",", ":"), sort_keys=True) + "\n").encode()


def routine(row):
    return (
        row.get("kind") == "grow"
        and row["kept"] == []
        and row["crashes"] == row["slow"] == 0
        and row["outcomes"]["crash"] == row["outcomes"]["slow"] == 0
        and row["arcs_before"] == row["arcs_after"]
        and row["entries_before"] == row["entries_after"]
        and row.get("stopped") in (None, "budget")
    )


def build(source, output):
    blob_hash = hashlib.sha1(f"blob {source.stat().st_size}\0".encode())
    source_hash = hashlib.sha256()
    archived, retained, row_map, day_rows = [], [], [], []
    totals = defaultdict(Counter)
    header = b""
    with source.open("rb") as handle:
        for ordinal, record in enumerate(handle, 1):
            blob_hash.update(record)
            source_hash.update(record)
            if ordinal == 1:
                header = record
            row = json.loads(record)
            stamp = row.get("when", "")
            if not stamp.startswith(DAY + "T"):
                continue
            if not stamp.endswith("Z"):
                raise ValueError(f"Source line {ordinal} is outside the pilot's UTC convention")
            day_rows.append(record)
            if routine(row):
                if set(row["outcomes"]) != set(OUTCOMES):
                    raise ValueError(f"Unexpected outcome schema on source line {ordinal}")
                scope = tuple(row[key] for key in SCOPE)
                if not all(isinstance(value, str) and value for value in scope):
                    raise ValueError(f"Incomplete scope on source line {ordinal}")
                archived.append(record)
                row_map.append(f"{ordinal}\tA\n")
                totals[scope].update(row["outcomes"])
                totals[scope]["grow_count"] += 1
                totals[scope]["tried"] += row["tried"]
            else:
                retained.append(record)
                row_map.append(f"{ordinal}\tR\n")

    if blob_hash.hexdigest() != SOURCE_BLOB:
        raise ValueError(f"Expected Git blob {SOURCE_BLOB}, got {blob_hash.hexdigest()}")

    if not archived or not retained:
        raise ValueError("Expected both archived and retained rows for the pinned day")

    archive = b"".join(archived)
    summaries = b"".join(
        line({"scope": dict(zip(SCOPE, scope)), "counts": counts})
        for scope, counts in sorted(totals.items())
    )
    files = {
        "ledger-header.jsonl": header,
        "routine.jsonl.gz": gzip.compress(archive, mtime=0),
        "retained.jsonl": b"".join(retained),
        "row-map.tsv": "".join(row_map).encode(),
        "summaries.jsonl": summaries,
    }
    manifest = {
        "schema": "homing-pigeon-shadow-archive-v1",
        "scope": {
            "commit": SOURCE_COMMIT, "path": SOURCE_PATH, "git_blob": SOURCE_BLOB,
            "utc_day": DAY, "source_sha256": source_hash.hexdigest(),
        },
        "rows": {
            "day": len(day_rows), "archived": len(archived), "retained": len(retained),
            "summary_groups": len(totals),
        },
        "checksums": {
            "day_raw_sha256": digest(b"".join(day_rows)),
            "routine_raw_sha256": digest(archive),
            "files_sha256": {name: digest(data) for name, data in files.items()},
        },
        "measures": {
            "routine_raw_bytes": len(archive),
            "routine_gzip_bytes": len(files["routine.jsonl.gz"]),
            "routine_text_tokens": tokens(archive),
            "summary_text_tokens": tokens(summaries),
            "row_map_text_tokens": tokens(files["row-map.tsv"]),
        },
        "row_map": "Each line is a 1-based original source line number, tab, and A (archive) or R (retained). Both streams keep source order.",
        "status": "Shadow archive. No source or live consumer changes.",
    }
    files["manifest.json"] = (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode()

    output.mkdir()
    for name, data in files.items():
        (output / name).write_bytes(data)
    reduction = tokens(archive) - sum(
        tokens(files[name]) for name in ("manifest.json", "row-map.tsv", "summaries.jsonl")
    )
    print(f"Archived {len(archived)} of {len(day_rows)} rows. Kept {len(retained)}.")
    print(f"Potential tracked-text reduction after summary, map, and manifest: {reduction:,} tokens.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("source", type=Path, help="Unmodified JSONL from the source Git blob")
    parser.add_argument("output", type=Path, help="New output directory (must not exist)")
    args = parser.parse_args()
    build(args.source, args.output)


if __name__ == "__main__":
    main()
END build_pilot.py

