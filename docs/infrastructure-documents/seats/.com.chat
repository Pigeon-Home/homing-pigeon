"""Check the finite map against its U0-1.0 specification and record evidence.

Agent-Stamp: 00000000-chatGPT-481e-81fe-3fc2a698901c

The reference grammar and truth tables are independent of finite_map's
enumerator, codec and witness verifier. The report separates exhaustive
checks within stated bounds from seeded input perturbations.
"""

import argparse
import hashlib
import itertools
import json
from pathlib import Path
import random
import sys

from runner.tools import finite_map


MAX_BITS = 20
BUDGET_GRID = (0, 1)
SAMPLE_ROUNDS = 512
NON_BINARY = tuple(chr(code) for code in range(128) if code not in (48, 49))


def reference_domain():
    """All canonical U0-1.0 encodings and the clauses they denote."""
    words = dict(zip(("00", "01", "10"), (0, 1, 2)))
    clauses = {
        "".join(codes): tuple(words[code] for code in codes)
        for codes in itertools.product(words, repeat=3)
        if codes != ("00", "00", "00")
    }
    return {
        f"{size:02b}" + "".join(combo): tuple(clauses[word] for word in combo)
        for size in range(4)
        for combo in itertools.combinations(sorted(clauses), size)
    }


def check_decode(word, expected):
    try:
        actual = finite_map.decode(word)
    except ValueError:
        if expected is None:
            return
        raise AssertionError(f"decoder rejected legal encoding {word!r}") from None
    if expected is None or actual != expected:
        raise AssertionError(f"decode({word!r}): expected {expected!r}, got {actual!r}")


def check_codec(domain):
    for width in range(MAX_BITS + 1):
        for value in range(1 << width):
            word = f"{value:0{width}b}" if width else ""
            check_decode(word, domain.get(word))
    for word, formula in domain.items():
        actual = finite_map.encode(formula)
        if actual != word:
            raise AssertionError(f"encode({formula!r}): expected {word!r}, got {actual!r}")
    return (1 << (MAX_BITS + 1)) - 1


def check_sampled_inputs(domain, seed):
    rng = random.Random(seed)
    legal_words = tuple(domain)
    for _ in range(SAMPLE_ROUNDS):
        word = rng.choice(legal_words)
        position = rng.randrange(len(word) + 1)
        check_decode(word[:position] + rng.choice(NON_BINARY) + word[position:], None)
        width = rng.randrange(MAX_BITS + 1, 2 * MAX_BITS + 1)
        check_decode(f"{rng.getrandbits(width):0{width}b}", None)
    return 2 * SAMPLE_ROUNDS


def assignment_bits(value):
    return tuple((value >> index) & 1 for index in range(3))


def truth_mask(clause):
    """Bit a is set when the clause holds on assignment number a."""
    # For each variable, these are the assignments making its literal true.
    positive = (0b10101010, 0b11001100, 0b11110000)
    mask = 0
    for code, ones in zip(clause, positive):
        mask |= (0, ones, ones ^ 0xFF)[code]
    return mask


def reference_search(masks, encoded_bits, c, d):
    base = encoded_bits + 2
    cap = (base**c).bit_length() - 1
    step_limit = base**d
    live_masks = masks[:step_limit]
    # The position of the first failing clause or the length of the prefix.
    steps_by_assignment = [
        next((i for i, mask in enumerate(live_masks, 1) if not mask & (1 << value)),
             len(live_masks))
        for value in range(8)
    ]
    witness = next((value for value in range(min(8, 1 << cap))
                    if len(masks) <= step_limit
                    and all(mask & (1 << value) for mask in masks)), None)
    # Programs are ordered by length and then value. The shortest program
    # for assignment a is its binary value with no leading zero bits.
    length = witness.bit_length() if witness is not None else None
    terminal = ((1 << length) + witness if witness is not None
                else (1 << (cap + 1)) - 1)
    total_steps = [0]
    for rank in range(1, terminal + 1):
        value = rank - (1 << (rank.bit_length() - 1))
        total_steps.append(total_steps[-1] + steps_by_assignment[value & 7])

    for allowance in sorted({0, terminal - 1, terminal, terminal + 1}):
        count = min(allowance, terminal)
        found = count == terminal and witness is not None
        yield allowance, {
            "status": "STOPPED" if count < terminal else ("FOUND" if found else "EXHAUSTED"),
            "found": found,
            "programs_run": count,
            "steps_used": total_steps[count],
            "witness_program_length": length if found else None,
            "witness_program_value": witness if found else None,
            "witness_assignment": assignment_bits(witness) if found else None,
        }


def check_search(domain):
    masks_by_clause = {clause: truth_mask(clause)
                       for formula in domain.values() for clause in formula}
    checks = 0
    for word, formula in domain.items():
        masks = tuple(masks_by_clause[clause] for clause in formula)
        for c, d in itertools.product(BUDGET_GRID, repeat=2):
            for allowance, expected in reference_search(masks, len(word), c, d):
                actual = finite_map.candidate_search(formula, c, d, allowance)
                if actual != expected:
                    raise AssertionError(
                        f"search({word}, c={c}, d={d}, allowance={allowance}): "
                        f"expected {expected!r}, got {actual!r}")
                checks += 1
    return checks


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--seed", type=int, default=0)
    parser.add_argument("--commit")
    args = parser.parse_args(argv)
    domain = reference_domain()
    report = {
        "commit": args.commit,
        "python": sys.version.split()[0],
        "implementation_sha256": hashlib.sha256(Path(finite_map.__file__).read_bytes()).hexdigest(),
        "checker_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        "scope": {"interpreter": "U0-1.0", "max_binary_length": MAX_BITS,
                  "formulas": len(domain), "c_and_d_values": list(BUDGET_GRID),
                  "allowances": "zero and one below, at, and one above the terminal program count"},
        "seed": args.seed,
        "checked": {},
    }
    try:
        report["checked"]["exhaustive_decoder_words"] = check_codec(domain)
        report["checked"]["exhaustive_encoder_formulas"] = len(domain)
        report["checked"]["search_budget_cases"] = check_search(domain)
        report["checked"]["sampled_decoder_rejections"] = check_sampled_inputs(domain, args.seed)
    except AssertionError as error:
        report.update(verdict="FAIL", discrepancy=str(error))
    else:
        report["verdict"] = "PASS"
    args.out.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    for name, count in report["checked"].items():
        print(f"- {name.replace('_', ' ')}: {count:,}")
    print(f"- Seed: {args.seed}; verdict: {report['verdict']}")
    if report["verdict"] == "FAIL":
        print(report["discrepancy"], file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

END CHECKER SOURCE

